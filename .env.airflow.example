# Copy to .env.airflow (gitignored) before starting the Airflow stack:
#   cp .env.airflow.example .env.airflow
#   # edit secrets below — never commit .env.airflow
#   ./scripts/ops/airflow_preflight.sh          # fails if missing/empty/placeholder
#   docker compose -f docker-compose.mysql.yml --env-file .env up -d
#   ./scripts/ops/start_airflow.sh              # preferred
#
# This file is both:
#   1) Compose --env-file input (POSTGRES_*, Fernet, Airflow admin)
#   2) Injected into Airflow containers via env_file + explicit ${VAR:?} env
# Placeholders below are REJECTED by airflow-preflight — replace before start.

AIRFLOW_IMAGE_NAME=apache/airflow:2.10.2-python3.11
AIRFLOW_UID=50000

# --- Airflow metadata DB + web UI (change before first start) ---
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace-me-airflow-admin
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace-me-postgres
POSTGRES_DB=airflow

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=replace-with-fernet-key

# Extra Python packages installed into Airflow containers on start
_PIP_ADDITIONAL_REQUIREMENTS="requests python-dotenv pyyaml pandas yfinance nltk feedparser beautifulsoup4 lxml pytrends mysql-connector-python"

# --- App secrets for DAG tasks (DB load / Notion sync) ---
# Reach analysis MySQL on shared Docker network intl_analysis_net (NOT host.docker.internal).
# Start MySQL first (creates the network), or: docker network create intl_analysis_net
# Host-side tools still use 127.0.0.1 via the loopback publish in docker-compose.mysql.yml.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=international_analysis

# Optional — Notion hub sync task
# NOTION_API_KEY=replace-me-notion-token

# Optional — host Ollama override (default is set in docker-compose.yaml)
# OLLAMA_HOST=http://host.docker.internal:11434
